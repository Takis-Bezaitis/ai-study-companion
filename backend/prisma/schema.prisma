// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActivityType {
  OPEN_QUESTION
  ROAD_RACE
}

enum GameType {
  ROAD_RACE
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id                      String           @id @default(uuid())
  email                   String           @unique
  passwordHash            String
  name                    String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  progress                UserProgress[]
  quizAttempts            QuizAttempt[]
  refreshSessions         RefreshSession[]
  openQuestions           OpenQuestion[]
  openQuestionEvaluations OpenQuestionEvaluation[]
  activityAttempts        ActivityAttempt[]
  gameSessions            GameSession[]
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  lessons   Lesson[]
}

model Lesson {
  id                String   @id @default(uuid())
  categoryId        String
  title             String
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chunks            LessonChunk[]
  progress          UserProgress[]
  quizzes           Quiz[]
  gameItems         GameItem[]
  gameMissions      GameMission[]
  openQuestions     OpenQuestion[]
  activityAttempts  ActivityAttempt[]
  gameSessions      GameSession[]

  @@index([categoryId])
}

model LessonChunk {
  id           String   @id @default(uuid())
  lessonId     String
  content      String
  sectionTitle String
  chunkIndex   Int
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())

  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, chunkIndex])
  @@index([lessonId])
}

model UserProgress {
  id              String   @id @default(uuid())
  userId          String
  lessonId        String
  lastAccessedAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Quiz {
  id            String      @id @default(uuid())
  lessonId      String
  title         String
  difficulty    Difficulty  @default(MEDIUM)
  questionCount Int
  createdAt     DateTime    @default(now())

  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      QuizAttempt[]

  @@index([lessonId])
}

model Question {
  id             String       @id @default(uuid())
  quizId         String
  type           QuestionType
  question       String
  options        Json?
  correctAnswer  String
  explanation    String?
  points         Int          @default(1)
  order          Int

  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers        QuizAnswer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model QuizAttempt {
  id          String       @id @default(uuid())
  userId      String
  quizId      String
  score       Float?
  startedAt   DateTime     @default(now())
  completedAt DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
}

model QuizAnswer {
  id          String       @id @default(uuid())
  attemptId   String
  questionId String
  answer      String
  isCorrect   Boolean
  points      Int          @default(0)
  createdAt   DateTime     @default(now())

  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model RefreshSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OpenQuestion {
  id                 String   @id @default(uuid())
  userId             String
  lessonId           String
  sectionTitle       String
  question           String
  referenceAnswer    String
  evaluationCriteria Json
  sourceChunkIds     String[]
  createdAt          DateTime @default(now())

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  evaluations OpenQuestionEvaluation[]

  @@index([userId, createdAt])
  @@index([lessonId, createdAt])
}

model OpenQuestionEvaluation {
  id              String   @id @default(uuid())
  userId          String
  questionId      String
  answer          String
  score           Float
  feedback        Json
  createdAt       DateTime @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        OpenQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  activityAttempt ActivityAttempt?

  @@index([userId, createdAt])
  @@index([questionId, createdAt])
}

model ActivityAttempt {
  id                       String       @id @default(uuid())
  userId                   String
  lessonId                 String
  activityType             ActivityType
  gameScore                Int          @default(0)
  educationalScore         Float        @default(0)
  openQuestionEvaluationId String?      @unique
  completedAt              DateTime     @default(now())

  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson                   Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  openQuestionEvaluation   OpenQuestionEvaluation? @relation(fields: [openQuestionEvaluationId], references: [id], onDelete: Cascade)
  gameSessionId            String?      @unique
  gameSession              GameSession? @relation(fields: [gameSessionId], references: [id], onDelete: SetNull)

  @@index([userId, activityType, completedAt])
  @@index([lessonId, activityType, completedAt])
  @@index([activityType, gameScore])
}

model GameSession {
  id        String            @id @default(uuid())
  userId    String
  lessonId  String
  gameType  GameType
  status    GameSessionStatus @default(ACTIVE)

  missionId String
  itemType  String

  startedAt DateTime          @default(now())
  endedAt   DateTime?
  updatedAt DateTime          @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityAttempt  ActivityAttempt?
  spawns           GameSessionSpawn[]
  mission          GameMission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([lessonId, gameType, status])
}

model GameSessionSpawn {
  id         String    @id @default(uuid())
  sessionId  String
  gameItemId String
  isCorrect  Boolean
  signature  String
  spawnedAt  DateTime  @default(now())
  resolvedAt DateTime?
  elapsedMs  Int?

  session  GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gameItem GameItem    @relation(fields: [gameItemId], references: [id], onDelete: Restrict)

  @@index([sessionId, resolvedAt])
  @@index([gameItemId])
}

model GameItem {
  id            String   @id @default(uuid())
  lessonId      String
  type          String
  name          String
  group         String?
  metadata      Json?
  createdAt     DateTime @default(now())

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessionSpawns GameSessionSpawn[]

  @@index([lessonId])
  @@index([lessonId, type])
  @@index([lessonId, type, group])
}

model GameMission {
  id                  String   @id @default(uuid())
  lessonId            String
  gameType            GameType
  title               String
  description         String?
  correctGroup        String
  wrongGroup          String?
  createdAt           DateTime @default(now())

  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessions            GameSession[]

  @@index([lessonId])
}